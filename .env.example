APP_NAME=Multi-Agent Support Ticket Automation API
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://support_app:CHANGE_ME@localhost:5432/support_tickets
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_EMBEDDING_MODEL=embeddinggemma
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION_NAME=support_knowledge
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_RELEVANCE=0.40
SOLUTION_MIN_CONFIDENCE=0.55
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.1
LANGGRAPH_STRICT_MSGPACK=true

# Docker Compose substitutions; never commit real values.
POSTGRES_DB=support_tickets
POSTGRES_USER=support_app
POSTGRES_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
